erDiagram

  %% ── CORE / AUTH ──────────────────────────────────────────────────────────
  User {
    uuid id PK
    varchar email
    boolean is_active
    boolean is_admi
    timestamp created_at
    timestamp last_login_at
  }

  AuthToken {
    uuid id PK
    uuid user_id FK
    varchar token
    timestamp expires_at
    timestamp used_at
  }

  AuthSession {
    uuid id PK
    uuid user_id FK
    varchar token
    timestamp expires_at
    timestamp created_at
  }

  AuditTrail {
    uuid id PK
    uuid organization_id FK
    uuid user_id FK
    varchar action
    varchar entity_type
    uuid entity_id
    jsonb metadata
    timestamp created_at
  }

  Organization {
    uuid id PK
    varchar name
    varchar type
    timestamp created_at
  }

  Membership {
    uuid id PK
    uuid user_id FK
    uuid organization_id FK
    uuid role_id FK
    timestamp joined_at
    timestamp coc_signed_at
  }

  DemographicData {
    uuid id PK
    uuid user_id FK
    varchar age_range
    varchar gender
    varchar ethnicity
    timestamp created_at
  }

  %% ── PERMISSIONS ──────────────────────────────────────────────────────────
  Role {
    uuid id PK
    varchar name
    text description
  }

  Permission {
    uuid id PK
    varchar code
    text description
  }

  RolePermission {
    uuid role_id FK
    uuid permission_id FK
  }

  ProgramTrack {
    uuid id PK
    varchar name
    text description
    boolean is_active
  }

  %% ── ANGELS CIRCLE ────────────────────────────────────────────────────────
  Angel {
    uuid id PK
    uuid user_id FK
    varchar first_name
    varchar last_name
    varchar company_name
    text investment_thesis
    varchar linkedin_url
    varchar contact_email
    boolean is_publicly_listed
    enum status
  }

  AngelOTP {
    uuid id PK
    uuid angel_id FK
    varchar code
    varchar token
    timestamp expires_at
    timestamp used_at
  }

  %% ── MENTORS CIRCLE ───────────────────────────────────────────────────────
  Mentor {
    uuid id PK
    uuid user_id FK
    varchar first_name
    varchar last_name
    text bio
    varchar booking_url
    enum status
  }

  IndustryTag {
    uuid id PK
    varchar name
  }

  ExpertiseTag {
    uuid id PK
    varchar name
  }

  GeographyTag {
    uuid id PK
    varchar name
  }

  MentorIndustryMap {
    uuid mentor_id FK
    uuid industry_tag_id FK
  }

  MentorExpertiseMap {
    uuid mentor_id FK
    uuid expertise_tag_id FK
  }

  MentorGeographyMap {
    uuid mentor_id FK
    uuid geography_tag_id FK
  }

  %% ── STARTUP / ALUMNI ─────────────────────────────────────────────────────
  Startup {
    uuid id PK
    uuid owner_user_id FK
    uuid program_track_id FK
    varchar name
    varchar cohort
    enum status
    timestamp created_at
    timestamp submitted_at
    boolean public_profile_enabled
    varchar one_liner
    text public_description
    varchar website_url
    varchar logo_url
    integer founding_year
    enum exit_status
  }

  %% ── DATA ROOM ────────────────────────────────────────────────────────────
  DataRoom {
    uuid id PK
    uuid startup_id FK
    varchar name
    timestamp created_at
  }

  DataRoomDocument {
    uuid id PK
    uuid data_room_id FK
    varchar title
    varchar s3_path
    timestamp uploaded_at
  }

  DataRoomLink {
    uuid id PK
    uuid data_room_id FK
    uuid created_by FK
    varchar token
    timestamp expires_at
    timestamp created_at
  }

  %% ── APPLICATION PIPELINE ─────────────────────────────────────────────────
  Application {
    uuid id PK
    uuid organization_id FK
    uuid track_id FK
    varchar cohort
    varchar status
    timestamp created_at
    timestamp submitted_at
  }

  Question {
    uuid id PK
    uuid track_id FK
    text text
    varchar type
    jsonb config
    integer order
    boolean is_required
  }

  QuestionBranch {
    uuid id PK
    uuid question_id FK
    jsonb condition
    uuid next_question_id FK
  }

  Response {
    uuid id PK
    uuid application_id FK
    uuid question_id FK
    jsonb answer
    timestamp created_at
  }

  %% ── RELATIONSHIPS ────────────────────────────────────────────────────────
  User ||--o{ AuthToken : "owns"
  User ||--o{ AuthSession : "starts"
  User ||--o{ AuditTrail : "performs"
  User ||--o{ Membership : "joins"
  User ||--o| DemographicData : "has (isolated)"
  User ||--o| Angel : "has"
  User ||--o| Mentor : "has"
  User ||--o{ Startup : "owns"
  User ||--o{ DataRoomLink : "created by"

  Organization ||--o{ Membership : "has"
  Organization ||--o{ AuditTrail : "records"

  Role ||--o{ Membership : "defines"
  Role ||--o{ RolePermission : "grants"
  Permission ||--o{ RolePermission : "linked to"

  ProgramTrack ||--o{ Startup : "categorizes"
  ProgramTrack ||--o{ Application : "has"
  ProgramTrack ||--o{ Question : "has"

  Angel ||--o{ AngelOTP : "authenticates via"

  Mentor ||--o{ MentorIndustryMap : "tagged with"
  Mentor ||--o{ MentorExpertiseMap : "tagged with"
  Mentor ||--o{ MentorGeographyMap : "tagged with"
  IndustryTag ||--o{ MentorIndustryMap : "applied to"
  ExpertiseTag ||--o{ MentorExpertiseMap : "applied to"
  GeographyTag ||--o{ MentorGeographyMap : "applied to"

  Startup ||--o| DataRoom : "has"
  DataRoom ||--o{ DataRoomDocument : "contains"
  DataRoom ||--o{ DataRoomLink : "generates"

  Application ||--o{ Response : "contains"
  Question ||--o{ Response : "answered by"
  Question ||--o{ QuestionBranch : "branches to"
